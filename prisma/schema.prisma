generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Categoria {
  id            BigInt         @id(map: "pk_categorias") @default(autoincrement())
  nombre        String         @db.VarChar(255)
  estado        Int            @db.SmallInt
  created_at    DateTime       @default(now()) @db.Timestamp(6)
  updated_at    DateTime       @default(now()) @db.Timestamp(6)
  trial611      String?        @db.Char(1)
  subCategorias SubCategoria[]

  @@map("categorias")
}

model SubCategoria {
  id          BigInt     @id(map: "pk_sub_categorias") @default(autoincrement())
  categoriaId BigInt     @map("id_categorias")
  nombre      String     @db.VarChar(255)
  estado      Int        @db.SmallInt
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @default(now()) @db.Timestamp(6)
  trial611    String?    @db.Char(1)
  productos   Producto[]
  categoria   Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "sub_categorias_id_categorias_foreign")

  @@map("sub_categorias")
}

model Marca {
  idMarca    BigInt     @id(map: "pk_marcas") @default(autoincrement()) @map("id_marca")
  nombre     String     @db.VarChar(255)
  estado     Int        @default(1) @db.SmallInt
  created_at DateTime   @default(now()) @db.Timestamp(6)
  updated_at DateTime   @default(now()) @db.Timestamp(6)
  trial611   String?    @db.Char(1)
  productos  Producto[]

  @@map("marcas")
}

model Color {
  id               BigInt            @id(map: "pk_color") @default(autoincrement())
  nombre           String            @db.VarChar(255)
  hexadecimal      String            @db.VarChar(255)
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @default(now()) @db.Timestamp(6)
  estado           Int               @default(1) @db.SmallInt
  trial611         String?           @db.Char(1)
  detallePreVentas DetallePreVenta[]
  variantes        Variante[]

  @@map("color")
}

model Talla {
  id               BigInt            @id(map: "pk_talla") @default(autoincrement())
  nombre           String            @db.VarChar(255)
  isActivo         Boolean           @default(true) @map("isactivo")
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @default(now()) @db.Timestamp(6)
  trial611         String?           @db.Char(1)
  detallePreVentas DetallePreVenta[]
  variantes        Variante[]

  @@map("talla")
}

model TipoDocumento {
  id         BigInt   @id(map: "pk_tipo_documento") @default(autoincrement())
  nombre     String   @db.VarChar(255)
  isactivo   Int      @default(1) @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  trial615   String?  @db.Char(1)
  compras    Compra[]

  @@map("tipo_documento")
}

model TipoMovimiento {
  id              BigInt           @id(map: "pk_tipo_movimiento") @default(autoincrement())
  nombre          String           @db.VarChar(255)
  isactivo        Int              @default(1) @db.SmallInt
  created_at      DateTime         @default(now()) @db.Timestamp(6)
  updated_at      DateTime         @default(now()) @db.Timestamp(6)
  trial618        String?          @db.Char(1)
  movimientosCaja MovimientoCaja[]

  @@map("tipo_movimiento")
}

model Producto {
  id               BigInt            @id(map: "pk_producto") @default(autoincrement())
  subCategoriaId   BigInt            @map("id_sub_categorias")
  marcaId          BigInt?           @map("id_marca")
  nombre           String            @db.VarChar(255)
  precioCompra     Decimal           @map("precio_compra") @db.Decimal(10, 2)
  precioVenta      Decimal           @map("precio_venta") @db.Decimal(10, 2)
  stockTotal       Int               @map("stock_total")
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @default(now()) @db.Timestamp(6)
  imagen           String?           @db.VarChar(255)
  trial611         String?           @db.Char(1)
  estado           Boolean?          @default(true)
  cambios          Cambio[]
  detalleCompras   DetalleCompra[]
  detallePreVentas DetallePreVenta[]
  detalleVentas    DetalleVenta[]
  marca            Marca?            @relation(fields: [marcaId], references: [idMarca], onUpdate: Restrict, map: "producto_id_marca_foreign")
  subCategoria     SubCategoria      @relation(fields: [subCategoriaId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "producto_id_sub_categorias_foreign")
  variantes        Variante[]

  @@map("producto")
}

model Variante {
  id            BigInt         @id(map: "pk_variante") @default(autoincrement())
  colorId       BigInt         @map("id_color")
  tallaId       BigInt         @map("id_talla")
  stock         Int
  productoId    BigInt         @map("id_producto")
  created_at    DateTime       @default(now()) @db.Timestamp(6)
  updated_at    DateTime       @default(now()) @db.Timestamp(6)
  trial611      String?        @db.Char(1)
  cambios       Cambio[]
  detalleVentas DetalleVenta[]
  color         Color          @relation(fields: [colorId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "variante_id_color_foreign")
  producto      Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "variante_id_producto_foreign")
  talla         Talla          @relation(fields: [tallaId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "variante_id_talla_foreign")

  @@map("variante")
}

model Proveedor {
  id           BigInt   @id(map: "pk_proveedor") @default(autoincrement())
  razonSocial  String   @map("razon_social") @db.VarChar(255)
  ruc          String   @db.VarChar(255)
  direccion    String   @db.VarChar(255)
  telefono     String   @db.VarChar(255)
  provincia    String   @db.VarChar(255)
  departamento String   @db.VarChar(255)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @db.Timestamp(6)
  trial615     String?  @db.Char(1)
  compras      Compra[]

  @@map("proveedor")
}

model Cliente {
  id         BigInt     @id(map: "pk_clientes") @default(autoincrement())
  nombre     String     @db.VarChar(255)
  documento  String     @unique(map: "clientes_documento_unique") @db.VarChar(255)
  created_at DateTime   @default(now()) @db.Timestamp(6)
  updated_at DateTime   @default(now()) @db.Timestamp(6)
  trial615   String?    @db.Char(1)
  preVentas  PreVenta[]
  ventas     Venta[]

  @@map("clientes")
}

model Compra {
  id              BigInt          @id(map: "pk_compra") @default(autoincrement())
  proveedorId     BigInt          @map("id_proveedor")
  tipoDocumentoId BigInt          @map("id_tipo_documento")
  total           Decimal         @db.Decimal(10, 2)
  fechaCompra     DateTime        @map("fecha_compra") @db.Date
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  updated_at      DateTime        @default(now()) @db.Timestamp(6)
  trial615        String?         @db.Char(1)
  proveedor       Proveedor       @relation(fields: [proveedorId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "compra_id_proveedor_foreign")
  tipoDocumento   TipoDocumento   @relation(fields: [tipoDocumentoId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "compra_id_tipo_documento_foreign")
  detalleCompras  DetalleCompra[]

  @@map("compra")
}

model Venta {
  id              BigInt         @id(map: "pk_ventas") @default(autoincrement())
  clienteId       BigInt?        @map("id_cliente")
  fecha           DateTime       @db.Timestamp(6)
  total           Decimal        @db.Decimal(10, 2)
  created_at      DateTime       @default(now()) @db.Timestamp(6)
  updated_at      DateTime       @default(now()) @db.Timestamp(6)
  metodoDePago    String?        @map("metodo_de_pago") @db.VarChar(255)
  trial615        String?        @db.Char(1)
  cdrUrl          String?        @map("cdr_url")
  estadoSunat     String?        @map("estado_sunat") @db.VarChar(20)
  hashSunat       String?        @map("hash_sunat")
  numero          BigInt?
  pdfUrl          String?        @map("pdf_url")
  serie           String?        @db.VarChar(4)
  tipoComprobante String?        @map("tipo_comprobante") @db.VarChar(2)
  xmlUrl          String?        @map("xml_url")
  detalleVentas   DetalleVenta[]
  cliente         Cliente?       @relation(fields: [clienteId], references: [id], onUpdate: Restrict, map: "ventas_id_cliente_foreign")

  @@map("ventas")
}

model PreVenta {
  id               BigInt            @id(map: "pk_pre_ventas") @default(autoincrement())
  clienteId        BigInt?           @map("id_cliente")
  total            Decimal           @db.Decimal(8, 2)
  estado           Int               @default(0) @db.SmallInt
  fecha            DateTime          @db.Timestamp(6)
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @default(now()) @db.Timestamp(6)
  trial615         String?           @db.Char(1)
  detallePreVentas DetallePreVenta[]
  cliente          Cliente?          @relation(fields: [clienteId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "pre_ventas_id_cliente_foreign")

  @@map("pre_ventas")
}

model MovimientoCaja {
  id               BigInt         @id(map: "pk_movimiento_caja") @default(autoincrement())
  tipoMovimientoId BigInt         @map("id_tipo_movimiento")
  descripcion      String         @db.VarChar(255)
  motivo           String         @db.VarChar(255)
  created_at       DateTime       @default(now()) @db.Timestamp(6)
  updated_at       DateTime       @default(now()) @db.Timestamp(6)
  trial618         String?        @db.Char(1)
  tipoMovimiento   TipoMovimiento @relation(fields: [tipoMovimientoId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "movimiento_caja_id_tipo_movimiento_foreign")

  @@map("movimiento_caja")
}

model DetalleCompra {
  id           BigInt   @id(map: "pk_detalle_compra") @default(autoincrement())
  productoId   BigInt   @map("id_producto")
  compraId     BigInt   @map("id_compra")
  cantidad     Int
  precioCompra Decimal  @map("precio_compra") @db.Decimal(10, 2)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @db.Timestamp(6)
  trial615     String?  @db.Char(1)
  compra       Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "detalle_compra_id_compra_foreign")
  producto     Producto @relation(fields: [productoId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "detalle_compra_id_producto_foreign")

  @@map("detalle_compra")
}

model DetalleVenta {
  id             BigInt    @id(map: "pk_detalle_venta") @default(autoincrement())
  productoId     BigInt    @map("id_producto")
  cantidad       Int
  ventaId        BigInt    @map("id_venta")
  varianteId     BigInt?   @map("id_variante")
  precioUnitario Decimal   @map("precio_unitario") @db.Decimal(10, 2)
  total          Decimal   @db.Decimal(10, 2)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @default(now()) @db.Timestamp(6)
  trial615       String?   @db.Char(1)
  producto       Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "detalle_venta_id_producto_foreign")
  variante       Variante? @relation(fields: [varianteId], references: [id], onUpdate: Restrict, map: "detalle_venta_id_variante_foreign")
  venta          Venta     @relation(fields: [ventaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "detalle_venta_id_venta_foreign")

  @@map("detalle_venta")
}

model DetallePreVenta {
  id             BigInt   @id(map: "pk_detalle_pre_ventas") @default(autoincrement())
  preVentaId     BigInt   @map("pre_venta_id")
  cantidad       Int
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(8, 2)
  subTotal       Decimal  @map("sub_total") @db.Decimal(8, 2)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @default(now()) @db.Timestamp(6)
  productoId     BigInt   @map("producto_id")
  tallaId        BigInt   @map("talla_id")
  colorId        BigInt   @map("color_id")
  trial615       String?  @db.Char(1)
  color          Color    @relation(fields: [colorId], references: [id], onUpdate: Restrict, map: "detalle_pre_ventas_color_id_foreign")
  preVenta       PreVenta @relation(fields: [preVentaId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "detalle_pre_ventas_pre_venta_id_foreign")
  producto       Producto @relation(fields: [productoId], references: [id], onUpdate: Restrict, map: "detalle_pre_ventas_producto_id_foreign")
  talla          Talla    @relation(fields: [tallaId], references: [id], onUpdate: Restrict, map: "detalle_pre_ventas_talla_id_foreign")

  @@map("detalle_pre_ventas")
}

model Cambio {
  id          BigInt   @id(map: "pk_cambios") @default(autoincrement())
  productoId  BigInt   @map("id_producto")
  cantidad    Int
  observacion String?  @db.VarChar(255)
  tipo        String   @db.VarChar(7)
  fecha       DateTime @db.Date
  varianteId  BigInt   @map("id_variante")
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  trial611    String?  @db.Char(1)
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cambios_id_producto_foreign")
  variante    Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cambios_id_variante_foreign")

  @@map("cambios")
}

model Usuario {
  id                   BigInt    @id(map: "pk_usuario") @default(autoincrement())
  nombre               String    @unique(map: "usuario_nombre_unique") @db.VarChar(255)
  cargo                String    @db.VarChar(255)
  clave                String    @db.VarChar(255)
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime  @default(now()) @db.Timestamp(6)
  trial621             String?   @db.Char(1)
  intentosFallidos     Int       @default(0)
  bloqueadoHasta       DateTime? @db.Timestamp(6)
  ultimoIntentoFallido DateTime? @db.Timestamp(6)

  @@map("usuario")
}

model cache {
  key        String  @id(map: "pk_cache") @db.VarChar(255)
  value      String
  expiration Int
  trial608   String? @db.Char(1)
}

model cache_locks {
  key        String  @id(map: "pk_cache_locks") @db.VarChar(255)
  owner      String  @db.VarChar(255)
  expiration Int
  trial611   String? @db.Char(1)
}

model failed_jobs {
  id         BigInt   @id(map: "pk_failed_jobs") @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String
  queue      String
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(6)
  trial618   String?  @db.Char(1)
}

model job_batches {
  id             String  @id(map: "pk_job_batches") @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
  trial618       String? @db.Char(1)
}

model jobs {
  id           BigInt  @id(map: "pk_jobs") @default(autoincrement())
  queue        String  @db.VarChar(255)
  payload      String
  attempts     Int     @db.SmallInt
  reserved_at  BigInt?
  available_at BigInt
  created_at   BigInt
  trial618     String? @db.Char(1)

  @@index([queue], map: "jobs_queue_index")
}

model migrations {
  id        Int     @id(map: "pk_migrations") @default(autoincrement())
  migration String  @db.VarChar(255)
  batch     Int
  trial618  String? @db.Char(1)
}

model password_reset_tokens {
  email      String    @id(map: "pk_password_reset_tokens") @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(6)
  trial618   String?   @db.Char(1)
}

model personal_access_tokens {
  id             BigInt    @id(map: "pk_personal_access_tokens") @default(autoincrement())
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt
  name           String    @db.VarChar(255)
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?
  last_used_at   DateTime? @db.Timestamp(6)
  expires_at     DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @default(now()) @db.Timestamp(6)
  trial618       String?   @db.Char(1)

  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model sessions {
  id            String  @id(map: "pk_sessions") @db.VarChar(255)
  user_id       BigInt?
  ip_address    String? @db.VarChar(45)
  user_agent    String?
  payload       String
  last_activity Int
  trial621      String? @db.Char(1)

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model tipo_doc_identidad {
  id         BigInt   @id(map: "pk_tipo_doc_identidad") @default(autoincrement())
  nombre     String   @db.VarChar(255)
  isactivo   Int      @default(1) @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  trial615   String?  @db.Char(1)
}

model tipo_pago {
  id         BigInt   @id(map: "pk_tipo_pago") @default(autoincrement())
  nombre     String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  trial615   String?  @db.Char(1)
}

model users {
  id                BigInt    @id(map: "pk_users") @default(autoincrement())
  name              String    @db.VarChar(255)
  email             String    @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamp(6)
  password          String    @db.VarChar(255)
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  updated_at        DateTime  @default(now()) @db.Timestamp(6)
  trial621          String?   @db.Char(1)
}
